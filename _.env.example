# Canonical VibeMind runtime configuration. This repository deliberately has
# no local llm_config.yml and must not carry provider credentials.
VIBEMIND_CONFIG_DIR=/absolute/path/to/vibemind-config

# Vector backend (optional)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6339
QDRANT_COLLECTION=codebase
# QDRANT_API_KEY=

# Backend port
EMBEDDINGGEMMA_BACKEND_PORT=8011

# Optional local cross-encoder reranker. This does not configure embeddings.
FUNGUS_RERANKER_DEVICE=cpu
