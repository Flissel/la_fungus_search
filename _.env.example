# The only Fungus embedding backend is VibeMind embedding-service. It owns the
# provider credential; do not set an OpenAI key or a local-model fallback here.
EMBEDDING_SERVICE_URL=http://embedding-service:8080
EMBEDDING_HTTP_TIMEOUT=30
EMBEDDING_HTTP_MAX_RETRIES=2
EMBEDDING_HTTP_RETRY_BACKOFF=0.5
# embedding-service emits 3072-dimensional vectors. Existing caches or Qdrant
# collections with another dimension require a separately planned reindex; do
# not rebuild or migrate them automatically from this repository.

# Vector backend (optional)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6339
QDRANT_COLLECTION=codebase
# QDRANT_API_KEY=

# Backend port
EMBEDDINGGEMMA_BACKEND_PORT=8011

# Optional local cross-encoder reranker. This does not configure embeddings.
FUNGUS_RERANKER_DEVICE=cpu
